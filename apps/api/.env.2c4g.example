APP_NAME=zhaolu-ai-v2
ENVIRONMENT=production
DEPLOYMENT_MODE=independent
INSTANCE_ID=ubuntu-2c4g-1
DATABASE_URL=mysql+asyncmy://zhaolu_app:CHANGE_ME@127.0.0.1:3306/zhaolu_v2
DATABASE_POOL_SIZE=8
DATABASE_MAX_OVERFLOW=4
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=300
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=zhaolu:2c4g
JWT_SECRET=replace_with_at_least_32_random_chars
AGENT_FAST_MODE=true
AGENT_CACHE_TTL_SECONDS=120
AGENT_CHAT_TIMEOUT_SECONDS=45
AGENT_STREAM_HEARTBEAT_SECONDS=5
AGENT_MIN_DATA_SUPPORT=0.65
AGENT_RISK_THRESHOLD=0.32
AGENT_PRIVACY_MIN_COHORT_SIZE=5
AGENT_MULTI_PLANNING_ENABLED=true
AGENT_PLAN_CONSISTENCY_THRESHOLD=1.0
AGENT_UNSUPPORTED_ANSWER_ALPHA=0.0
AGENT_P95_LATENCY_BUDGET_MS=2000
MINIMIND_ENABLED=false
MINIMIND_BASE_URL=http://127.0.0.1:8998/v1
MINIMIND_MODEL=MiniMind-3
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false
PYTHONUNBUFFERED=1

RAG_VECTOR_ENABLED=true
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_CACHE_DIR=./models/embedding
RAG_EMBEDDING_TIMEOUT_SECONDS=20
RAG_VECTOR_WEIGHT=0.55

ROUTER_ML_ENABLED=true
ROUTER_ML_MODEL_PATH=./models/router/router.onnx
ROUTER_ML_TOKENIZER_PATH=./models/router/tokenizer.json
ROUTER_ML_LABEL_MAP_PATH=./models/router/label_map.json
ROUTER_ML_CONFIDENCE_THRESHOLD=0.5

LOCAL_SQL_MODEL_ENABLED=false
LOCAL_SQL_MODEL_BASE_URL=
LOCAL_SQL_MODEL_NAME=
LOCAL_SQL_MODEL_API_KEY=
LOCAL_SQL_TIMEOUT_SECONDS=15
LOCAL_SQL_MAX_ROWS=200
LOCAL_SQL_QUERY_TIMEOUT_SECONDS=10
